# Copier ce fichier en .env et renseigner les valeurs.
# ⚠️ Toute variable VITE_ est visible dans le JavaScript envoyé aux visiteurs :
#    n'y mettez JAMAIS de clé secrète (service_role, LigdiCash, clé privée VAPID…).

# Supabase > Project Settings > API
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=votre_cle_anon_publique

# Notifications push vendeur (clé PUBLIQUE uniquement) — voir docs/MISE-EN-PRODUCTION.md
VITE_VAPID_PUBLIC_KEY=

# Suivi des erreurs (facultatif) — DSN du projet Sentry
VITE_SENTRY_DSN=

# Côté Vercel uniquement (fonction api/og.js), pas besoin en local :
# SITE_URL=https://festisolde.com
